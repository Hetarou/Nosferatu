  m_EditorClassIdentifier: 
  NameToShow: "\u30AF\u30ED"
  TextToShow: "\u304A\u521D\u306E\u65B9\u306F\u59CB\u3081\u307E\u3057\u3066\u3001\u539F\u6848\u30FB\u30B7\u30CA\u30EA\u30AA\u62C5\u5F53\u306E\u30AF\u30ED\u3067\u3059\u3002 
    \u3000\u672C\u4F5C\u306F\u3001\u63A5\u70B9\u304C\u306A\u3044\u306F\u305A\u3060\u3063\u305F\u6B63\u53CD\u5BFE\u306E\u4E8C\u4EBA\u306E\u5C11\u5973\u304C\u51FA\u4F1A\u3044\u3001\u672C\u5F53\u306E\u610F\u5473\u3067\u53CB\u4EBA\u3068\u306A\u308B\u307E\u3067\u3092\u63CF\u3044\u305F\u7269\u8A9E\u3067\u3059\u3002 
    \u3000\u53CB\u4EBA\u3068\u306F\u898B\u4E0B\u3052\u3066\u4ED8\u304D\u5408\u3063\u3066\u3084\u308B\u3053\u3068\u3067\u3082\u306A\u3051\u308C\u3070\u3001\u898B\u4E0A\u3052\u3066\u4ED8\u304D\u5408\u3063\u3066\u3082\u3089\u3046\u3053\u3068\u3067\u3082\u3042\u308A\u307E\u305B\u3093\u3002\u4E92\u3044\u3092\u5C0A\u656C\u3057\u3042\u3048\u308B\u3088\u3046\u306B\u306A\u3063\u305F\u5F7C\u5973\u305F\u3061\u306F\u3069\u3093\u306A\u56F0\u96E3\u3082\u7B11\u3044\u306A\u304C\u3089\u4E57\u308A\u8D8A\u3048\u3066\u884C\u304F\u3053\u3068\u3067\u3057\u3087\u3046\u3002 
    \u3000\u3055\u3066\u3001\u672C\u7DE8\u3067\u8A9E\u3089\u306A\u304B\u3063\u305F\u4E8B\u4EF6\u5F8C\u306E\u831C\u306E\u304A\u8A71\u3092\u5C11\u3005\u3002 
    \u3000\u5927\u304D\u306A\u904E\u3061\u3092\u72AF\u3057\u3066\u3057\u307E\u3063\u305F\u831C\u3055\u3093\u3067\u3059\u304C\u3001\u8972\u3063\u3066\u304D\u305F\u30C1\u30F3\u30D4\u30E9\u3055\u3093\u305F\u3061\u304C\u902E\u6355\u3055\u308C\u308B\u306E\u3068\u540C\u6642\u306B\u4FDD\u8B77\u3055\u308C\u308B\u5F62\u3067\u8B66\u5BDF\u306B\u78BA\u4FDD\u3055\u308C\u307E\u3057\u305F\u3002\u7D14\u7C8B\u306A\u88AB\u5BB3\u8005\u3068\u52D8\u9055\u3044\u3055\u308C\u305F\u305F\u3081\u3067\u3059\u3002 
    \u3000\u305D\u306E\u5F8C\u3001\u4E8B\u60C5\u8074\u53D6\u306E\u4E2D\u3067\u831C\u306E\u4E8B\u4EF6\u3068\u306E\u95A2\u308F\u308A\u304C\u660E\u3089\u304B\u306B\u306A\u308A\u307E\u3059\u3002\u305D\u3057\u3066\u3001\u539F\u56E0\u3092\u7406\u89E3\u3059\u308B\u3068\u831C\u306E\u4E21\u89AA\u306F\u9811\u5F35\u3063\u3066\u3044\u308B\u306E\u3092\u77E5\u3063\u3066\u3044\u305F\u306E\u306B\u30CF\u30C3\u30D1\u306E\u639B\u3051\u65B9\u3092\u9593\u9055\u3048\u305F\u3002\u81EA\u5206\u305F\u3061\u304C\u60AA\u304B\u3063\u305F\u306E\u3060\u3068\u831C\u306B\u6CE3\u3044\u3066\u8B1D\u308A\u307E\u3057\u305F\u3002 
    \u3000\u4E21\u89AA\u306B\u611B\u60C5\u304C\u3042\u3063\u305F\u3053\u3068\u3092\u77E5\u308A\u3001\u534A\u3070\u4EE5\u4E0A\u306B\u81EA\u66B4\u81EA\u68C4\u3060\u3063\u305F\u831C\u306F\u3088\u3046\u3084\u304F\u51B7\u9759\u3055\u3092\u53D6\u308A\u623B\u307E\u3059\u3002\u81EA\u5206\u304C\u3057\u3066\u3057\u307E\u3063\u305F\u3053\u3068\u306E\u611A\u304B\u3055\u306B\u6C17\u4ED8\u304D\u3001\u3069\u3046\u511F\u3046\u3079\u304D\u304B\u3082\u308F\u304B\u3089\u306A\u3044\u307E\u307E\u30DB\u30B7\u30CE\u306B\u982D\u3092\u4E0B\u3052\u307E\u3059\u3002 
    \u3000\u540C\u3058\u304F\u9032\u3080\u3079\u304D\u9053\u304C\u308F\u304B\u3089\u306A\u304F\u306A\u3063\u3066\u3044\u305F\u8005\u3068\u3057\u3066\u3001\u661F\u898B\u306F\u3053\u306E\u8B1D\u7F6A\u304C\u672C\u5FC3\u304B\u3089\u306E\u3082\u306E\u3067\u3042\u308B\u3068\u7406\u89E3\u3057\u3001\u8D66\u3057\u307E\u3057\u305F\u3002 
    \u3000\u305D\u306E\u5F8C\u3001\u831C\u306F\u53D7\u9A13\u3092\u3084\u3081\u3001\u50CD\u304D\u51FA\u3057\u307E\u3059\u3002\u5009\u5EAB\u306E\u8EFD\u4F5C\u696D\u3084\u5DE5\u4E8B\u306A\u3069\u982D\u3067\u306F\u306A\u304F\u4F53\u3092\u4F7F\u3046\u4ED5\u4E8B\u3092\u9078\u3093\u3060\u306E\u3082\u601D\u3046\u3068\u3053\u308D\u304C\u3042\u3063\u305F\u304B\u3089\u3067\u3057\u305F\u3002 
